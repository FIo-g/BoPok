# 값은 .env.local에 넣는다. 이 파일에는 이름만 둔다 (docs/roles/common.md 2장).

# DB — 비워 두면 로컬 PGlite(.pglite 폴더)를 쓴다. 배포 때만 Neon 연결 주소를 넣는다
DATABASE_URL=
# 로컬 PGlite 폴더 위치 (선택, 기본 .pglite)
PGLITE_DIR=

# 로그인 — Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI — Upstage Solar Pro (기본), opencode (대체)
UPSTAGE_API_KEY=
OPENCODE_API_KEY=

# 경로·장소 검색 — TMAP
TMAP_APP_KEY=

# 관광지 목록 — 한국관광공사 TourAPI (데이터 스크립트에서만)
TOURAPI_SERVICE_KEY=

# 1이면 프론트가 API 대신 src/mocks의 가짜 데이터를 쓴다
NEXT_PUBLIC_USE_MOCKS=1
