# 값은 .env.local에 넣는다. 이 파일에는 이름만 둔다 (docs/roles/common.md 2장).

# DB — 비워 두면 로컬 PGlite(.pglite 폴더)를 쓴다. 배포 때만 Neon 연결 주소를 넣는다
DATABASE_URL=
# 로컬 PGlite 폴더 위치 (선택, 기본 .pglite)
PGLITE_DIR=

# 로그인 — Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# AI — Claude 먼저 → Upstage → opencode
# Claude(Anthropic) — 키가 비어 있으면 Claude는 쓰지 않음
ANTHROPIC_API_KEY=
# 모델 — 비우면 claude-opus-5-5. 서버 쪽 대체 모델(fallbacks)을 지원하는 모델만 쓴다 — 아니면 매번 거절되어 조용히 Upstage로 넘어간다
ANTHROPIC_MODEL=
UPSTAGE_API_KEY=
OPENCODE_API_KEY=
# 주소·모델 — 비우면 기본값
UPSTAGE_BASE_URL=
UPSTAGE_MODEL=
OPENCODE_BASE_URL=
# 비우면 opencode 대체를 쓰지 않음
OPENCODE_MODEL=

# 경로·장소 검색 — TMAP
TMAP_APP_KEY=

# 공공데이터포털 일반 인증키 — 관광지 목록(TourAPI, 데이터 스크립트)과 날씨(기상청 단기·중기예보, 서버)가 같이 쓴다.
# 포털에서 기상청_단기예보·중기예보·기상특보 조회서비스도 활용신청해야 날씨·특보가 나온다. 비우면 날씨 카드는 "못 불러왔어요"
TOURAPI_SERVICE_KEY=

# 1이면 프론트가 API 대신 src/mocks의 가짜 데이터를 쓴다
NEXT_PUBLIC_USE_MOCKS=1
