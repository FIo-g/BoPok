{
  "name": "bopok",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/map/copy-map-assets.mjs && next dev",
    "build": "node scripts/map/copy-map-assets.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "map:assets": "node scripts/map/copy-map-assets.mjs",
    "map:style": "node scripts/map/build-map-style.mjs",
    "map:buildings": "node --max-old-space-size=8192 scripts/map/build-buildings.mjs && node scripts/map/build-trees.mjs",
    "map:trees": "node scripts/map/build-trees.mjs",
    "map:boundary": "node scripts/map/build-boundary.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "^1.2.0",
    "@turf/turf": "^7.4.0",
    "drizzle-orm": "^0.45.4",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-map-gl": "^8.1.3",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/geojson-vt": "^3.2.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "geojson-vt": "^5.0.4",
    "mapshaper": "^0.7.101",
    "osmtogeojson": "3.0.0-beta.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5",
    "vt-pbf": "^3.1.3"
  },
  "packageManager": "pnpm@12.8.1"
}
